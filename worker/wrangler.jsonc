{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ji-healthcare-ai-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "secrets": {
    "required": ["OPENAI_API_KEY", "APP_ACCESS_TOKEN"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
